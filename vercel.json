{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/Daiske-Brandan-Resume\\.pdf$",
      "status": 308,
      "headers": {
        "Location": "/Hikari_Brandan_Resume.pdf"
      }
    },
    {
      "src": "^/(projects/(?:ugc-camera|menutap|foodspot-mobile|macos-app-suite|the-auto-barber)|build-notes)(?:/|\\.html)$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(projects/(?:ugc-camera|menutap|foodspot-mobile|macos-app-suite|the-auto-barber)|build-notes)$",
      "dest": "/$1.html"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml|favicon\\.svg|Hikari_Brandan_Resume\\.pdf)$",
      "dest": "/$1"
    },
    {
      "src": "^/api/contact$",
      "dest": "/api/contact",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    }
  ]
}
